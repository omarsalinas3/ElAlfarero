  m_Script: {fileID: 11500000, guid: 1935871b61bcc3e4b8438cc55c247742, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Alfarero.Runtime::SecuenciaIntro
  vinetas:
  - imagen: {fileID: 21300000, guid: 879e3d4b58dec7c4dbb82cd99bad239e, type: 3}
    texto: "Libre del hechizo, el Alebrije se inclin\xF3 ante Mateo. La Talavera consagrada hab\xEDa roto la magia del Charro."
  - imagen: {fileID: 21300000, guid: 2031673b6c081a146b31f5c929596c91, type: 3}
    texto: Pero de Carmen solo quedaba su rebozo. El Charro Negro la arrastraba por el desierto, rumbo al pueblo fantasma de Mineral de Pozos.
  - imagen: {fileID: 21300000, guid: f644eaf1ab5d3df4c96dfc523d453a95, type: 3}
    texto: "Mateo mont\xF3 al Alebrije y sigui\xF3 las huellas de fuego. Las leyendas del Baj\xEDo lo estaban esperando."
  imagen: {fileID: 4178267}
  grupoImagen: {fileID: 4178264}
  texto: {fileID: 140759362}
  letrasPorSegundo: 38
  escenaSiguiente: Viaje_Pozos
