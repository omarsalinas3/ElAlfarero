  m_Name: 
  m_EditorClassIdentifier: Alfarero.Runtime::DialogoInicio
  lineas:
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Llegaste lejos, alfarero. Este r\xEDo est\xE1 lleno de l\xE1grimas que nadie consuela."
  - personaje: CARMEN
    retrato: {fileID: 21300000, guid: d152c1d839a0b344e8e17987e4c5f861, type: 3}
    texto: "\xA1Mateo, ella tambi\xE9n est\xE1 hechizada! \xA1La Talavera puede liberarla!"
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Si cruzas el pante\xF3n, nos veremos en los t\xFAneles... si es que lo cruzas."
  espera: 3.2
