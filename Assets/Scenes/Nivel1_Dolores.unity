--- !u!114 &1444687218
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1444687217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00c3841943e35b44f9a1552d91f6260d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Alfarero.Runtime::DialogoInicio
  lineas:
  - personaje: DON TORIBIO
    retrato: {fileID: 21300000, guid: a6fd321871f726a41a22e06ac8e91737, type: 3}
    texto: "\xA1Mateo, muchacho! El Charro Negro se llev\xF3 a Carmen. Lo vi cruzar la plaza rumbo a la parroquia."
  - personaje: DON TORIBIO
    retrato: {fileID: 21300000, guid: a6fd321871f726a41a22e06ac8e91737, type: 3}
    texto: Sus bandidos tomaron las calles y hasta los mineros muertos se levantaron de la mina.
  - personaje: DON TORIBIO
    retrato: {fileID: 21300000, guid: a6fd321871f726a41a22e06ac8e91737, type: 3}
    texto: "Ll\xE9vate mis piezas de Talavera consagrada: rompen cualquier hechizo. \xA1Corre a la parroquia y no te detengas!"
  espera: 3.2
