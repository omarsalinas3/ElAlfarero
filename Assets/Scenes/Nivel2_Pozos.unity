  m_Name: 
  m_EditorClassIdentifier: Alfarero.Runtime::DialogoInicio
  lineas:
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "\xBFLiberaste a mi alebrije, alfarero? Bienvenido a Mineral de Pozos... tu tumba."
  - personaje: CARMEN
    retrato: {fileID: 21300000, guid: d152c1d839a0b344e8e17987e4c5f861, type: 3}
    texto: "\xA1Mateo! \xA1No le creas! \xA1Sigue las huellas de fuego!"
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Mi Jinete te espera en la capilla. \xC9l ya no tiene cabeza que perder... t\xFA s\xED."
  espera: 9
