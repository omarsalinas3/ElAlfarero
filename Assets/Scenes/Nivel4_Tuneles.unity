  m_EditorClassIdentifier: Alfarero.Runtime::EncuentroCharro
  jefe: {fileID: 1461978128}
  barraJefe: {fileID: 1610577387}
  xAparicion: 90.75
  xLlegada: 80.75
  ySuelo: -4.5
  musicaPelea: 6
  pacto:
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Mataste a mi caballo, alfarero. Pocos llegan tan lejos en mis t\xFAneles."
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Toma este oro y olv\xEDdate de Carmen. Vete por donde viniste y vivir\xE1s."
  - personaje: MATEO
    retrato: {fileID: 0}
    texto: "Gu\xE1rdate tu oro, Charro. \xA1Vine por Carmen y no me voy sin ella!"
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Entonces arder\xE1s con las dem\xE1s almas de esta mina."
