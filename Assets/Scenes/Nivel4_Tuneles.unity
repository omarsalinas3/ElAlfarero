--- !u!114 &1044821472
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1044821471}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00c3841943e35b44f9a1552d91f6260d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Alfarero.Runtime::DialogoInicio
  lineas:
  - personaje: CARMEN
    retrato: {fileID: 21300000, guid: d152c1d839a0b344e8e17987e4c5f861, type: 3}
    texto: "\xA1Mateo! \xA1Estoy aqu\xED abajo! El Charro dice que al amanecer ya ser\xE1 tarde..."
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Bienvenido a mi casa, alfarero. Aqu\xED abajo la luna roja nunca se pone."
  - personaje: EL CHARRO NEGRO
    retrato: {fileID: 21300000, guid: 4999fdf268d2c4c4fb5e5812923f0d92, type: 3}
    texto: "Mis muchachos te esperan en cada galer\xEDa. Y si ellos no pueden... la mina te va a tragar."
  espera: 3.2
